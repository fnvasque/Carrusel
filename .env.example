# Base de conocimiento y remix. Copia a .env y completa (nunca lo subas a git).
OPENAI_API_KEY=

# API oficial de Meta (solo lectura; ver README, "Configuración de Meta"). Verifica con npm run meta:check.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Bot de Telegram (npm run kb:bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# DMs a la cuenta de Instagram → guardar ficha (lo recibe el mismo npm run kb:bot; ver README)
# META_WEBHOOK_VERIFY_TOKEN=un-texto-al-azar-que-tu-eliges
# INBOX_ALLOWED_SENDERS=           # IGSID de tus cuentas, separados por coma (el bot los registra al escribirle)
# KB_INBOX_PORT=8787

# Servidor always-on (compose.yaml; ver deploy/README.md)
# NGROK_AUTHTOKEN=                    # túnel del webhook (el mismo de tu ngrok; el script de deploy lo copia solo)
# KB_REPO=git@github.com:fnvasque/ia-es-kb.git   # repo PRIVADO de la base
# Calendario automático (ver README, "Calendario y métricas", y deploy/README.md)
# Estas cuatro van IGUALES en el .env del Mac y en el del servidor (~/carrusel/.env):
# MEDIA_PUBLIC_TOKEN=                 # token largo y aleatorio (openssl rand -hex 32); sin él no se sirven medios. Nunca lo compartas ni lo pegues en un chat
# MEDIA_PUBLIC_BASE=                  # URL pública del túnel ngrok, p. ej. https://tu-dominio.ngrok-free.dev (sin / al final)
# Solo en el .env del MAC (render):
# SERVER_HOST=ubuntu@<ip-del-servidor> # el mismo usuario@ip de scripts/deploy-to-server.sh (ssh con clave, sin contraseña)
# SERVER_MEDIA_DIR=carrusel/media     # ruta en el HOST del servidor (~/carrusel/media), NO /data/media (la del contenedor). Solo letras, números y _ . / - (sin espacios)
# Solo en el .env del SERVIDOR (el bot publica):
# CALENDARIO_MODO=auto                # auto (publica en Instagram) | aviso (todo menos los POST a Meta, para depurar); sin la variable el scheduler no arranca. No la pongas en el Mac

# Render del calendario en el Mac (npm run calendario:render; launchd cada hora: scripts/calendario-install-mac.sh)
# Obligatorias en el Mac: SERVER_HOST, SERVER_MEDIA_DIR, MEDIA_PUBLIC_BASE, MEDIA_PUBLIC_TOKEN.
# Avisa por Telegram con TELEGRAM_BOT_TOKEN y TELEGRAM_ALLOWED_CHAT_IDS (sendMessage directo; no arranca el bot).
# CALENDARIO_AUDIO_DIR=promo/audio    # carpeta de las pistas de los reels (sus nombres van en config.audios de la base)
# CALENDARIO_RSYNC_LOCAL=1            # solo pruebas: copia a SERVER_MEDIA_DIR en este disco en vez de usar ssh
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=     # ruta al Chromium ya instalado; nunca corras playwright install (launchd la fija sola en el plist)

# Modelos baratos por OpenRouter: un KB_MODEL con "/" va por OpenRouter; si falla, se repite con KB_FALLBACK_MODEL.
# Comparación con posts reales: npx tsx scripts/kb-comparar-modelos.ts <url@usuario> ...
# OPENROUTER_API_KEY=
# KB_MODEL=deepseek/deepseek-v4.1-flash
# KB_FALLBACK_MODEL=gpt-4o-2024-11-20
# KB_OPENROUTER_TIMEOUT_MS=90000      # tras esto se pasa al respaldo

# Opcionales
# KB_DIR=./knowledge
# KB_MODEL=gpt-4o-2024-11-20          # default: OpenAI directo
# KB_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# KB_ASK_MODEL=deepseek/deepseek-v4.1-flash   # respuestas de kb:ask (default gpt-4o; no hereda KB_MODEL; mismo respaldo)
# KB_EMBED_MODEL=text-embedding-3-small
# KB_JUDGE_MODEL=gpt-4o-mini          # decide si dos temas dudosos son el mismo
# KB_TOPIC_SIMILARITY=0.8             # ≥ esto, un tema nuevo se une al existente parecido
# KB_TOPIC_REVIEW=0.55                # entre esto y el umbral, decide el modelo juez
# KB_MAX_IMAGES=12                    # imágenes/cuadros por post que se analizan
# KB_FRAME_DETAIL=low                 # detalle de los cuadros de reels (low ≈ 1/13 del costo de high)
# KB_SYNTH_MODEL=gpt-4o-2024-11-20    # modelo de los resúmenes de tema (default: KB_MODEL)
# KB_TOPIC_SYNTH_HOURS=24             # horas mínimas entre resúmenes de un tema (0 = en cada guardado)
# KB_PRICES='{"modelo":{"in":0.2,"out":0.6}}'   # USD por 1M tokens de modelos sin precio conocido (kb:costos)
# KB_GIT=0          # no commitear cada guardado
# KB_GIT_PUSH=1     # push de respaldo tras cada commit
