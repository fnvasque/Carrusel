{
  "name": "carrusel",
  "version": "0.1.0",
  "private": true,
  "description": "Generador de carruseles de Instagram por código, con fondos generados por IA.",
  "type": "module",
  "scripts": {
    "generate": "tsx src/cli.ts",
    "reel": "tsx src/reel/cli.ts",
    "remix": "tsx src/remix/cli.ts",
    "meta:check": "tsx src/meta/check.ts",
    "score": "tsx src/score/cli.ts",
    "record": "tsx src/score/record.ts",
    "calibrate": "tsx src/score/calibrate.ts",
    "typecheck": "tsc --noEmit",
    "test:reel": "tsx test/reel-runtime.ts",
    "test": "tsx test/smoke.ts && tsx test/kb.ts",
    "kb:add": "tsx src/kb/cli.ts add",
    "kb:ask": "tsx src/kb/cli.ts ask",
    "kb:undo": "tsx src/kb/cli.ts undo",
    "kb:reindex": "tsx src/kb/cli.ts reindex",
    "kb:temas": "tsx src/kb/cli.ts temas",
    "kb:costos": "tsx src/kb/cli.ts costos",
    "kb:bot": "tsx src/kb/bot.ts"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "openai": "^4.67.0",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
